#!/bin/bash
set -euo pipefail
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$BIN/lib/common.sh"
require jq

# True when the file opens with a frontmatter block declaring internal: true.
report_stamped() {
  awk 'NR == 1 { if ($0 != "---") exit 1; next }
       $0 == "---" { exit 1 }
       $0 == "internal: true" { found = 1; exit 0 }
       END { exit !found }' "$1"
}

sweep() {
  local lf rid term envname branch num state age_days
  # Runs from before run state moved out of the checkout are invisible here,
  # so their envs would never be torn down. Say so rather than skip silently.
  if [ "$AUTOFIX_ROOT/runs" != "$RUNS_DIR" ] && compgen -G "$AUTOFIX_ROOT/runs/*/ledger.json" >/dev/null; then
    log "sweep: runs under $AUTOFIX_ROOT/runs are not swept; move them into $RUNS_DIR"
  fi
  for lf in "$RUNS_DIR"/*/ledger.json; do
    [ -f "$lf" ] || continue
    # a single malformed ledger must not abort the sweep (which would also
    # block `run`, since it sweeps first) — skip it and keep going
    jq -e 'type == "object"' "$lf" >/dev/null 2>&1 \
      || { log "sweep: skipping unparsable ledger $lf"; continue; }
    rid="$(jq -r '.run_id // empty' "$lf")"; term="$(jq -r '.terminal // empty' "$lf")"
    envname="$(jq -r '.env.name // empty' "$lf")"
    [ -n "$term" ] || continue
    case "$term" in
      bailed-*)
        if [ -z "$envname" ]; then
          log "sweep: $rid ($term) — no env to clean"
        else
          branch="$(jq -r '.branch // empty' "$lf")"
          if [ -z "$branch" ]; then
            # no branch was ever created — nothing unpushed to lose, waive
            log "sweep: destroying env of bailed run $rid (no branch recorded)"
            bash "$BIN/env.sh" destroy "$rid" --waive-push-check || true
          else
            # a branch exists (e.g. bailed-no-repro after Stage 2 provisioned a
            # worktree with unpushed evidence commits) — let env.sh's fail-closed
            # push-check/anchor-tag safeguards govern; log and continue if refused
            log "sweep: destroying env of bailed run $rid (branch $branch — push check governs)"
            bash "$BIN/env.sh" destroy "$rid" \
              || log "sweep: destroy refused for bailed run $rid (push check) — leaving env $envname"
          fi
        fi ;;
      delivered)
        num="$(jq -r '.pr.number // empty' "$lf")"
        [ -n "$num" ] && [ -n "$envname" ] || continue
        state="$(gh pr view "$num" --json state -q .state 2>/dev/null || echo OPEN)"
        case "$state" in MERGED|CLOSED)
          log "sweep: PR #$num $state — destroying env of $rid"
          bash "$BIN/env.sh" destroy "$rid" || log "sweep: destroy blocked for $rid (push check)"
        esac ;;
      escalated)
        [ -n "$envname" ] || continue
        stamped="$(jq -r '.stage_history[-1].at // empty' "$lf")"
        # An unparseable timestamp must be loud. The previous `|| date +%s`
        # fallback substituted *now*, making age_days 0 for every run — so on any
        # platform where the parse failed (e.g. GNU date, which rejects BSD's
        # -j -f) the TTL sweep silently never reaped anything.
        if ! epoch="$(iso8601_to_epoch "$stamped")"; then
          log "sweep: ESCALATED run $rid has an unusable timestamp ('$stamped') — cannot age it; skipping TTL check"
          continue
        fi
        age_days=$(( ( $(date +%s) - epoch ) / 86400 ))
        # if-guarded: a trailing failed `[ ... ] && log` would abort the whole
        # sweep under set -e when the run is younger than the TTL
        if [ "$age_days" -ge "$AUTOFIX_ESCALATED_ENV_TTL_DAYS" ]; then
          log "sweep: ESCALATED run $rid env $envname is ${age_days}d old — operator decision needed (autofix env destroy $rid)"
        fi ;;
    esac
  done
}

mint_run_id() { # issue-id
  local issue hex cand
  issue="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  while :; do
    hex="$(openssl rand -hex 2)"
    cand="autofix-$issue-$(date +%Y%m%d)-$hex"
    [ -e "$RUNS_DIR/$cand" ] || { echo "$cand"; return; }
  done
}

cmd="${1:?usage: autofix intake|run|run-secure|resume|report|runs|cleanup ...}"; shift
case "$cmd" in
  intake) exec bash "$BIN/intake.sh" queue "$@" ;;
  run)
    issue="${1:?issue id}"; shift
    sweep
    summary="$(bash "$BIN/intake.sh" check "$issue" "$@")" || exit $?
    rid="$(mint_run_id "$issue")"
    bash "$BIN/ledger.sh" init "$rid" "$issue" operator-named >/dev/null
    stem="$(printf '%s' "$summary" | jq -r .branchName)"
    bash "$BIN/ledger.sh" set "$rid" '.decisions += [{key:"branch_stem", value:$v}]' --arg v "$stem"
    bash "$BIN/claim.sh" claim "$issue" "$rid"
    echo "RUN_ID=$rid"
    echo "NEXT: stages 1-7 are orchestrated by the autofix skill (see .claude/skills/autofix/SKILL.md)" ;;
  run-secure)
    # supervised, disclosure-hardened path for Security-labeled issues.
    # Entry ack (spec Piece 1): a deliberate second signal, so a Security issue
    # is never picked up casually. Enforcement is ledger-driven thereafter.
    [ "${AUTOFIX_SECURE:-}" = 1 ] \
      || die "run-secure requires AUTOFIX_SECURE=1 in the environment (deliberate entry ack)"
    issue="${1:?issue id}"; shift
    sweep
    summary="$(bash "$BIN/intake.sh" check-secure "$issue" "$@")" || exit $?
    rid="$(mint_run_id "$issue")"
    bash "$BIN/ledger.sh" init "$rid" "$issue" secure >/dev/null
    # Not Linear's branchName: it is slugged from the title, which here tends
    # to describe the flaw, and the branch is pushed to a public repo.
    stem="$(neutral_branch_stem "$issue")"
    bash "$BIN/ledger.sh" set "$rid" '.decisions += [{key:"branch_stem", value:$v}]' --arg v "$stem"
    bash "$BIN/claim.sh" claim "$issue" "$rid"
    echo "RUN_ID=$rid"
    echo "SECURE=true"
    echo "NEXT: stages 1-7 via the autofix-secure skill; disclosing writes are gated (see .claude/skills/autofix-secure/SKILL.md)" ;;
  resume)
    rid="${1:?run id}"
    bash "$BIN/ledger.sh" reclaim "$rid" || true
    log "stage: $(bash "$BIN/ledger.sh" get "$rid" .stage) terminal: $(bash "$BIN/ledger.sh" get "$rid" '.terminal // "none"')"
    echo "RUN_ID=$rid"
    if is_secure "$rid"; then
      echo "SECURE=true"
      echo "NEXT: reconcile state, then continue via the autofix-secure skill — gates remain active (ledger-driven)"
    else
      echo "NEXT: reconcile against Linear/GitHub/env state, then continue from the recorded stage (autofix skill)"
    fi ;;
  report)
    # A run's report sits beside its ledger, outside every repository. --init
    # creates it; a secure run's copy starts with `internal: true`, marking it
    # as never to be published, for readers and for any pre-push check that
    # looks for that frontmatter. is_secure fails closed, so a run whose ledger
    # cannot be read is stamped too. noclobber keeps a concurrent --init from
    # truncating a report the other call has started writing. Writing the
    # report usually replaces the whole file, so every call on a secure run
    # puts the stamp back if the write dropped it.
    [ $# -le 2 ] || die "usage: autofix report <run-id> [--init]"
    rid="${1:?usage: autofix report <run-id> [--init]}"
    case "$rid" in */*|.|..) die "not a run id: $rid" ;; esac
    [ -f "$RUNS_DIR/$rid/ledger.json" ] || die "no run $rid under $RUNS_DIR"
    rpt="$RUNS_DIR/$rid/report.md"
    case "${2:-}" in
      "") ;;
      --init)
        if [ ! -e "$rpt" ]; then
          if is_secure "$rid"; then
            ( set -C; printf -- '---\ninternal: true\n---\n\n' > "$rpt" ) 2>/dev/null || true
          else
            ( set -C; : > "$rpt" ) 2>/dev/null || true
          fi
        fi ;;
      *) die "usage: autofix report <run-id> [--init]" ;;
    esac
    if [ -s "$rpt" ] && is_secure "$rid" && ! report_stamped "$rpt"; then
      tmp="$(umask 077; mktemp "$rpt.XXXXXX")"
      if [ "$(head -1 "$rpt")" = "---" ]; then
        { echo "---"; echo "internal: true"; tail -n +2 "$rpt"; } > "$tmp"
      else
        { printf -- '---\ninternal: true\n---\n\n'; cat "$rpt"; } > "$tmp"
      fi
      mv "$tmp" "$rpt"; log "report: restored internal: true on $rid"
    fi
    echo "$rpt" ;;
  runs)
    # One line per run: id, issue, secure or not, terminal state or stage.
    for lf in "$RUNS_DIR"/*/ledger.json; do
      [ -f "$lf" ] || continue
      jq -r '[.run_id, .issue, (if .secure then "secure" else "-" end), (.terminal // .stage // "?")] | @tsv' "$lf" 2>/dev/null \
        || log "runs: skipping unparsable ledger $lf"
    done ;;
  cleanup) sweep ;;
  *) die "unknown command: $cmd" ;;
esac
