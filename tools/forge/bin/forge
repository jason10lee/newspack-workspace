#!/bin/bash
# forge — the commands the forge's dispatcher session runs. Run sessions never
# run these. See tools/forge/README.md.
set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/forge.sh"
. "$AUTOFIX_BIN_DIR/lib/profile.sh"

mint_forge_id() { # issue
  local issue hex cand
  issue="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  while :; do
    hex="$(openssl rand -hex 2)"
    cand="forge-$issue-$(date +%Y%m%d)-$hex"
    [ -e "$RUNS_DIR/$cand" ] || { echo "$cand"; return; }
  done
}

# issue_busy <issue> — the id of any run, in any mode, still working that issue
# or waiting on the operator's decision about it.
issue_busy() {
  local lf
  for lf in "$RUNS_DIR"/*/ledger.json; do
    [ -f "$lf" ] || continue
    jq -r --arg i "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')" \
      'select((.issue | ascii_upcase) == $i and .terminal == null and .retired_at == null) | .run_id' \
      "$lf" 2>/dev/null || true
  done | head -1
}

# Set while a launch is in progress: FORGE_MADE_WT=made once this launch has
# added the run's worktree, and FORGE_RELAUNCH_PRIOR holds the fields a rework
# cleared, so a failed relaunch can put them back.
FORGE_MADE_WT=""
FORGE_RELAUNCH_PRIOR=""

# abandon <rid> <launch|untrusted> <reason> — a launch that failed after the
# ledger existed. A new run becomes terminal, so it holds no slot or pool dir,
# and a worktree this launch made is removed with its unused branch. A failed
# rework instead gets its prior state back: it touches no worktree, because the
# one in the ledger may be a monorepo env's.
abandon() {
  local rid="$1" kind="$2" why="$3" wt br repo
  if [ -n "$FORGE_RELAUNCH_PRIOR" ]; then
    bash "$FORGE_LEDGER" set "$rid" '. + $p' --argjson p "$FORGE_RELAUNCH_PRIOR"
    bash "$FORGE_LEDGER" history "$rid" rework launch-failed "$why"
    echo "REWORK-FAILED $rid: $why. The run is back as it was; rework it again when the cause is fixed."
    exit 4
  fi
  bash "$FORGE_LEDGER" set "$rid" '.launch = "abandoned" | .terminal = $t' --arg t "bailed-$kind"
  bash "$FORGE_LEDGER" history "$rid" launch abandoned "$why"
  wt="$(bash "$FORGE_LEDGER" get "$rid" '.worktree // empty')"
  if [ "$FORGE_MADE_WT" = made ] && [ -n "$wt" ] && [ -d "$wt" ]; then
    repo="$(profile_get "$rid" '.repo // empty')"; repo="${repo:-$WORKSPACE_ROOT}"
    br="$(bash "$FORGE_LEDGER" get "$rid" '.branch // empty')"
    git -C "$repo" worktree remove "$wt" >/dev/null 2>&1 || log "could not remove $wt; remove it before reusing the pool dir"
    [ -z "$br" ] || git -C "$repo" branch -d "$br" >/dev/null 2>&1 || log "kept branch $br"
  fi
  echo "ABANDONED $rid: $why"
  exit 4
}

# prepare_worktree <rid> — for a profile with no env, the run's worktree goes
# inside its pool dir, which the operator has already trusted. A monorepo run's
# worktree comes from env.sh in Stage 2.
prepare_worktree() {
  local rid="$1" repo base stem branch wt
  [ "$(profile_get "$rid" '.env')" = true ] && return 0
  repo="$(profile_get "$rid" '.repo // empty')"; repo="${repo:-$WORKSPACE_ROOT}"
  base="$(profile_base "$rid" "$repo")"
  stem="$(ledger_decision "$rid" branch_stem)"
  branch="$stem-$(openssl rand -hex 2)"
  wt="$(bash "$FORGE_LEDGER" get "$rid" .pool_dir)/wt"
  [ ! -e "$wt" ] || die "the pool dir already holds a worktree: $wt"
  git -C "$repo" worktree add -q "$wt" -b "$branch" "$base" || die "could not add the worktree $wt"
  bash "$FORGE_LEDGER" set "$rid" '.worktree = $w | .branch = $b' --arg w "$wt" --arg b "$branch"
  printf made
}

write_brief() { # rid -> path of the brief
  local rid="$1" f
  f="$RUNS_DIR/$rid/brief.md"
  jq -r --arg ledger "$RUNS_DIR/$rid/ledger.json" '
"# Forge run \(.run_id)

You are a forge run session. You work one Linear issue to delivery and stop there.

- Run id: \(.run_id)
- Issue: \(.issue)
- Ledger: \($ledger). Read and update it only with `\(.tooling.dir)/tools/autofix/bin/ledger.sh`.
- Tooling, pinned at \(.tooling.sha): `\(.tooling.dir)`. Run every autofix and forge script from there, never from a checkout.
- Profile: \([.decisions[] | select(.key == "profile") | .value] | last)
- Worktree: \(.worktree // "made by env.sh in Stage 2")

Follow the forge skill at `\(.tooling.dir)/.claude/skills/forge/SKILL.md` from Stage 0. If that file does not exist, record `stage: launch, outcome: no-skill` in the ledger history and end the session without claiming anything.

These rules apply even though this directory loads no project instructions:

- Never push, open a PR, or post to Linear or GitHub. The only Linear writes you may make are the claim and the conditional restore, through `tools/autofix/bin/claim.sh`.
- Commit messages carry `Co-Authored-By: Claude Opus 5.5 (1M context) 🔨 <noreply@anthropic.com>` and never a `Claude-Session:` trailer.
- Work only in the run'"'"'s worktree. Never check out a branch in the root checkout.
"' "$RUNS_DIR/$rid/ledger.json" > "$f"
  printf '%s\n' "$f"
}

# start_session <rid> — settings, brief, session, launch handshake. Each step
# that can fail after the ledger exists ends in abandon, never in a bare die.
start_session() {
  local rid="$1" tdir pool settings brief id rc=0
  tdir="$(bash "$FORGE_LEDGER" get "$rid" .tooling.dir)"
  pool="$(bash "$FORGE_LEDGER" get "$rid" .pool_dir)"
  settings="$( (write_run_settings "$rid" "$tdir") )" || abandon "$rid" launch "could not write the run's settings"
  brief="$( (write_brief "$rid") )" || abandon "$rid" launch "could not write the brief"
  id="$(launch_session "$rid" "$pool" "$settings" "You are forge run $rid. Read $brief and follow it.")" || rc=$?
  case "$rc" in
    0) ;;
    3) abandon "$rid" untrusted "the pool dir $pool is not trusted yet. Run \`claude\` there once, accept the trust prompt, quit, and launch again" ;;
    *) abandon "$rid" launch "claude --bg did not start a session" ;;
  esac
  bash "$FORGE_LEDGER" set "$rid" '.session = {id: $i, launched_at: $t}' --arg i "$id" --arg t "$(now_utc)"
  if confirm_launch "$rid" "$id"; then
    printf 'LAUNCHED %s\nRUN_ID=%s\nSESSION=%s\nPOOL=%s\n' "$rid" "$rid" "$id" "$pool"
  else
    abandon "$rid" launch "session $id was not seen within ${FORGE_LAUNCH_TIMEOUT}s"
  fi
}

launch_new() { # issue profile
  local issue="$1" profile="$2" summary rc=0 pool pin rid stem busy
  busy="$(issue_busy "$issue")"
  [ -z "$busy" ] || { echo "ALREADY $issue: run $busy is working it or waiting on your decision; rework or retire it"; exit 5; }
  summary="$(bash "$AUTOFIX_BIN_DIR/intake.sh" check "$issue")" || rc=$?
  case "$rc" in
    0) ;;
    2) secure_queue_add "$issue"
       echo "ROUTED-SECURE $issue: it carries the Security label, so the forge will not work it. Nothing was written. Start a supervised run with: AUTOFIX_SECURE=1 tools/autofix/bin/autofix run-secure $issue"
       exit 2 ;;
    3) echo "EXISTING-PR $issue: the issue already has a PR attachment. Nothing was written."; exit 3 ;;
    *) die "intake check failed for $issue" ;;
  esac
  pool="$(pool_take "$profile")" || {
    queue_add issue "$issue" "$profile"
    echo "QUEUED $issue: every $profile pool dir is held by a run waiting on your decision: $(pool_holders "$profile" | tr '\n' ' ')"
    return 0; }
  pin="$(pin_tooling)"
  rid="$(mint_forge_id "$issue")"
  bash "$FORGE_LEDGER" init "$rid" "$issue" forge >/dev/null
  stem="$(printf '%s' "$summary" | jq -r '.branchName // empty')"
  [ -n "$stem" ] || stem="$(printf '%s' "$issue" | tr '[:upper:]' '[:lower:]')"
  bash "$FORGE_LEDGER" set "$rid" \
    '.decisions += [{key: "branch_stem", value: $s}, {key: "profile", value: $p}]
     | .pool_dir = $d | .tooling = {sha: $sha, dir: $dir} | .launch_started_at = $t' \
    --arg s "$stem" --arg p "$profile" --arg d "$pool" --arg sha "${pin%% *}" --arg dir "${pin#* }" \
    --arg t "$(now_utc)"
  FORGE_MADE_WT="$( (prepare_worktree "$rid") )" || abandon "$rid" launch "could not prepare the run's worktree"
  start_session "$rid"
}

# relaunch <rid> — rework: a new session for the same run, on the same pool
# dir, worktree and pinned tooling. A run that stopped early or died goes back
# through Stage 0's claim, which the skill does on seeing launch=confirmed.
relaunch() {
  local rid="$1"
  FORGE_RELAUNCH_PRIOR="$(bash "$FORGE_LEDGER" get "$rid" '{delivery, terminal, launch, session, launch_started_at} | tojson')"
  bash "$FORGE_LEDGER" set "$rid" '.delivery = null | .terminal = null | .launch = null | .session = null
    | .launch_started_at = $t' --arg t "$(now_utc)"
  bash "$FORGE_LEDGER" history "$rid" rework relaunching ""
  start_session "$rid"
}

cmd_launch() { # ISSUE [--profile NAME]
  local issue="${1:?usage: forge launch <ISSUE> [--profile NAME]}" profile=newspack-workspace rc=0
  shift
  while [ $# -gt 0 ]; do
    case "$1" in --profile) profile="${2:?--profile needs a name}"; shift 2 ;; *) die "unknown flag: $1" ;; esac
  done
  printf '%s' "$issue" | LC_ALL=C grep -Eq '^[A-Za-z]+-[0-9]+$' || die "not an issue id: $issue"
  jq -e --arg p "$profile" 'has($p)' "$AUTOFIX_PROFILES" >/dev/null 2>&1 \
    || die "no kept profile named $profile (a drafted profile is never launched)"
  slot_free || rc=$?
  [ "$rc" -ne 2 ] || die "cannot read the forge's run state"
  if [ "$rc" -ne 0 ]; then
    queue_add issue "$issue" "$profile"
    echo "QUEUED $issue: the slot is held by $(slot_holders | tr '\n' ' ')"
    return 0
  fi
  launch_new "$issue" "$profile"
}

cmd_next() {
  local rc=0 line
  slot_free || rc=$?
  [ "$rc" -ne 2 ] || die "cannot read the forge's run state"
  [ "$rc" -eq 0 ] || { echo "SLOT-BUSY $(slot_holders | tr '\n' ' ')"; return 0; }
  line="$(queue_head)" || { echo "QUEUE-EMPTY"; return 0; }
  queue_pop
  # shellcheck disable=SC2086  # queue lines are space-separated words
  set -- $line
  case "$1" in
    issue) launch_new "$2" "$3" ;;
    rework) relaunch "$2" ;;
    *) die "bad queue line: $line" ;;
  esac
}

# check_run <rid> — the spec's liveness rule for one run holding the slot. A
# session is gone when its row has no pid. A stop that does not take changes
# nothing; a run that delivered or stopped meanwhile keeps its state.
check_run() {
  local rid="$1" launch id last epoch age why issue rel deadline st state started
  launch="$(bash "$FORGE_LEDGER" get "$rid" '.launch // ""')"
  if [ "$launch" != confirmed ]; then
    # A launch whose dispatcher died before confirming or abandoning it would
    # hold the slot for good. Once it is well past the confirm window, end it.
    started="$(bash "$FORGE_LEDGER" get "$rid" '.launch_started_at // empty')"
    if [ -z "$launch" ] && epoch="$(iso8601_to_epoch "$started")" \
       && [ $(( $(date +%s) - epoch )) -gt $(( FORGE_LAUNCH_TIMEOUT + FORGE_STALE_MARGIN )) ]; then
      id="$(bash "$FORGE_LEDGER" get "$rid" '.session.id // empty')"
      [ -z "$id" ] || claude stop "$id" >/dev/null 2>&1 || true
      bash "$FORGE_LEDGER" set "$rid" '.launch = "abandoned" | .terminal = "bailed-stale"'
      bash "$FORGE_LEDGER" history "$rid" launch abandoned "launch never confirmed; started $started"
      echo "STALE-LAUNCH $rid: its launch started $started and was never confirmed; abandoned. Its pool dir stays held until you retire it."
      return 0
    fi
    echo "PENDING $rid (launch: ${launch:-unset})"; return 0
  fi
  id="$(bash "$FORGE_LEDGER" get "$rid" '.session.id // empty')"
  [ -n "$id" ] || { echo "NO-SESSION $rid: confirmed but no session id recorded; leaving it"; return 0; }
  last="$(bash "$FORGE_LEDGER" get "$rid" '([.stage_history[].at] | max) // .session.launched_at // empty')"
  if ! epoch="$(iso8601_to_epoch "$last")"; then
    echo "UNKNOWN-PROGRESS $rid: no usable progress time ('$last'), so it is not judged stalled"
    epoch="$(date +%s)"
  fi
  age=$(( $(date +%s) - epoch ))
  state="$(session_state "$id")"
  case "$state" in
    unknown) echo "UNKNOWN-STATE $rid: could not read session $id from claude agents; changed nothing"; return 0 ;;
    alive)
      if [ "$age" -le "$FORGE_STAGE_BOUND" ]; then echo "ALIVE $rid ($id, last progress ${age}s ago)"; return 0; fi
      why="stalled: no progress for ${age}s"
      claude stop "$id" >/dev/null 2>&1 || true
      deadline=$(( $(date +%s) + FORGE_STOP_TIMEOUT ))
      state="$(session_state "$id")"
      while [ "$state" != gone ] && [ "$(date +%s)" -lt "$deadline" ]; do
        sleep "$FORGE_POLL_INTERVAL"; state="$(session_state "$id")"
      done
      if [ "$state" != gone ]; then
        echo "STOP-UNCONFIRMED $rid: asked $id to stop ($why) and could not confirm it ended (state: $state); changed nothing"
        return 0
      fi ;;
    *) why="session $id is gone" ;;
  esac
  st="$(bash "$FORGE_LEDGER" get "$rid" '.terminal // .delivery.kind // empty')"
  [ -z "$st" ] || { echo "SETTLED $rid ($st)"; return 0; }
  bash "$FORGE_LEDGER" set "$rid" '.terminal = "bailed-dead"'
  bash "$FORGE_LEDGER" history "$rid" liveness bailed-dead "$why"
  issue="$(bash "$FORGE_LEDGER" get "$rid" .issue)"
  if [ "$(bash "$FORGE_LEDGER" get "$rid" '[.stage_history[] | select(.stage == "intake" and .outcome == "claimed")] | length')" -gt 0 ]; then
    if bash "$AUTOFIX_BIN_DIR/claim.sh" release "$issue" "$rid" >/dev/null 2>&1; then rel="restored"
    else rel="the restore failed; check $issue by hand"; fi
  else
    rel="nothing claimed"
  fi
  echo "BAILED-DEAD $rid: $why; Linear: $rel"
}

cmd_check() {
  local holders rid
  holders="$(slot_holders)" || die "cannot read the forge's run state"
  [ -n "$holders" ] || { echo "NO-RUNS"; return 0; }
  while IFS= read -r rid; do check_run "$rid"; done <<EOH
$holders
EOH
}

require_forge_run() { # rid
  case "$1" in ""|*/*|.|..) die "not a run id: $1" ;; esac
  [ -f "$RUNS_DIR/$1/ledger.json" ] || die "no run $1"
  [ "$(bash "$FORGE_LEDGER" get "$1" .mode)" = forge ] || die "$1 is not a forge run"
}

cmd_status() {
  local lfs lf id alive
  lfs="$(forge_ledgers)" || exit 1
  printf 'run\tissue\tlaunch\tstage\tstate\tpool\tsession\talive\n'
  [ -z "$lfs" ] || while IFS= read -r lf; do
    id="$(jq -r '.session.id // ""' "$lf")"
    alive="-"; [ -z "$id" ] || alive="$(session_state "$id")"
    jq -r --arg a "$alive" '[.run_id, .issue, (.launch // "-"), (.stage // "-"),
      (if .retired_at then "retired" else (.terminal // .delivery.kind // "working") end),
      (.pool_dir // "-"), (.session.id // "-"), $a] | @tsv' "$lf"
  done <<EOL
$lfs
EOL
  echo; echo "queue:"; cat "$FORGE_STATE/queue" 2>/dev/null || true
  echo "secure queue (start these with autofix-secure):"; cat "$FORGE_STATE/secure-queue" 2>/dev/null || true
}

cmd_rework() { # rid suggestion...
  local rid="${1:?usage: forge rework <run id> <suggestion>}" term del
  shift
  [ $# -gt 0 ] || die "usage: forge rework <run id> <suggestion>"
  require_forge_run "$rid"
  [ "$(bash "$FORGE_LEDGER" get "$rid" '.retired_at // empty')" = "" ] || die "$rid is retired"
  term="$(bash "$FORGE_LEDGER" get "$rid" '.terminal // empty')"
  del="$(bash "$FORGE_LEDGER" get "$rid" '.delivery.kind // empty')"
  case "$term" in
    "") [ -n "$del" ] || die "$rid is still working; rework waits for its delivery" ;;
    bailed-dead) ;;
    routed-secure) die "$rid went to autofix-secure; the forge does not work security issues" ;;
    *) die "$rid ended as $term; launch the issue again instead" ;;
  esac
  bash "$FORGE_LEDGER" set "$rid" '.decisions += [{key: "rework", value: $v}]' --arg v "$*"
  queue_add rework "$rid"
  echo "REWORK-QUEUED $rid"
  cmd_next
}

cmd_retire() { # rid
  local rid="${1:?usage: forge retire <run id>}" wt pool repo
  require_forge_run "$rid"
  [ "$(bash "$FORGE_LEDGER" get "$rid" '.retired_at // empty')" = "" ] || { echo "RETIRED $rid (already)"; return 0; }
  [ "$(bash "$FORGE_LEDGER" get "$rid" 'if .terminal == null and .delivery == null then "working" else "" end')" = "" ] \
    || die "$rid is still working; it can be retired once it delivers or ends"
  wt="$(bash "$FORGE_LEDGER" get "$rid" '.worktree // empty')"
  pool="$(bash "$FORGE_LEDGER" get "$rid" '.pool_dir // empty')"
  if [ -n "$wt" ] && [ -n "$pool" ] && [ "${wt#"$pool"/}" != "$wt" ] && [ -d "$wt" ]; then
    [ -z "$(git -C "$wt" status --porcelain)" ] || die "$wt has uncommitted changes; commit or discard them first"
    repo="$(profile_get "$rid" '.repo // empty')"; repo="${repo:-$WORKSPACE_ROOT}"
    git -C "$repo" worktree remove "$wt" || die "could not remove $wt"
    echo "removed $wt; branch $(bash "$FORGE_LEDGER" get "$rid" '.branch // "-"') kept"
  elif [ -n "$(bash "$FORGE_LEDGER" get "$rid" '.env.name // empty')" ]; then
    echo "env and worktree kept; destroy them with: tools/autofix/bin/env.sh destroy $rid"
  fi
  bash "$FORGE_LEDGER" set "$rid" '.retired_at = $t' --arg t "$(now_utc)"
  bash "$FORGE_LEDGER" history "$rid" retire retired ""
  prune_tooling || true
  echo "RETIRED $rid"
}

# sq <text> — the text in single quotes, for a command a batch approves.
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# heredoc_cmd <command> <file> — the command fed the file through a quoted
# heredoc, so the batch binds the body's bytes. The delimiter is one no body
# line equals.
heredoc_cmd() {
  local d=FORGE_BODY n=0 body
  body="$(cat "$2")"
  while printf '%s\n' "$body" | grep -qx "$d"; do n=$((n + 1)); d="FORGE_BODY_$n"; done
  printf "%s <<'%s'\n%s\n%s" "$1" "$d" "$body" "$d"
}

# repo_slug <remote url> — owner/name for gh -R, from a github.com URL only.
repo_slug() {
  printf '%s' "$1" | LC_ALL=C sed -nE \
    's#^(https://github\.com/|git@github\.com:|ssh://git@github\.com/)([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)$#\2#p' \
    | sed 's/\.git$//'
}

cmd_batch() { # rid — the publish batch, built from pr.sh prepare's record
  local rid="${1:?usage: forge batch <run id>}" wt head remote branch base repo url slug pr_base
  local title issue plan role path sha body_f="" summary_f="" closeout_f="" n
  require_forge_run "$rid"
  lgr() { bash "$FORGE_LEDGER" get "$rid" "$1"; }
  [ "$(lgr '.retired_at // ""')" = "" ] || die "$rid is retired"
  [ "$(lgr '.terminal // ""')" = "" ] && [ "$(lgr '.delivery.kind // ""')" = delivered ] \
    || die "$rid has not delivered; only a delivered run is published"
  [ "$(lgr '.prepared // ""')" != "" ] || die "$rid has no pr.sh prepare record"
  head="$(lgr .prepared.head)"; remote="$(lgr .prepared.remote)"
  branch="$(lgr .prepared.branch)"; base="$(lgr .prepared.base)"
  printf '%s\n%s\n%s' "$remote" "$branch" "$base" | LC_ALL=C grep -Eqv '^[A-Za-z0-9._/-]+$' \
    && die "unexpected characters in the remote, branch or base of the prepare record"
  wt="$(lgr '.worktree // ""')"
  [ "$(git -C "$wt" rev-parse HEAD 2>/dev/null)" = "$head" ] \
    || die "the branch moved since pr.sh prepare (head was $head); prepare again"
  while IFS="$(printf '\t')" read -r role path sha; do
    [ -n "$path" ] || continue
    [ -f "$path" ] && [ "$(secure_digest "$path")" = "$sha" ] || die "$path changed since pr.sh prepare; prepare again"
    case "$role" in
      body) body_f="$path" ;; summary) summary_f="$path" ;; closeout) closeout_f="$path" ;;
      *) die "a body in the prepare record has no role; run pr.sh prepare again with the current tooling" ;;
    esac
  done <<EOF
$(lgr '.prepared.files[] | [(.role // "-"), .path, .sha256] | @tsv')
EOF
  [ -n "$body_f" ] || die "no PR body in the prepare record"
  title="$(ledger_decision "$rid" pr_title)"
  [ -n "$title" ] || die "no pr_title decision in the ledger"
  case "$title" in *$'\n'*) die "the PR title has a newline" ;; esac
  repo="$(profile_get "$rid" '.repo // empty')"; repo="${repo:-$WORKSPACE_ROOT}"
  url="$(git -C "$repo" remote get-url "$remote" 2>/dev/null)" || die "no remote $remote in $repo"
  slug="$(repo_slug "$url")"
  [ -n "$slug" ] || die "remote $remote ($url) is not a github.com repository; the forge publishes only there"
  pr_base="$base"
  git -C "$repo" show-ref --verify -q "refs/remotes/$base" && pr_base="${base#*/}"
  issue="$(lgr .issue)"
  plan="$(dirname "$(bash "$FORGE_LEDGER" path "$rid")")/batch.jsonl"
  {
    jq -nc --arg c "git -C $(sq "$repo") push $remote $head:refs/heads/$branch" '{tool: "Bash", tool_input: {command: $c}}'
    jq -nc --arg c "$(heredoc_cmd "gh pr create -R $slug --draft --base $pr_base --head $branch --title $(sq "$title") --body-file -" "$body_f")" \
      '{tool: "Bash", tool_input: {command: $c}}'
    [ -z "$summary_f" ] || jq -nc --arg c "$(heredoc_cmd "gh pr comment $branch -R $slug --body-file -" "$summary_f")" \
      '{tool: "Bash", tool_input: {command: $c}}'
    [ -z "$closeout_f" ] || jq -nc --arg i "$issue" --rawfile b "$closeout_f" \
      '{tool: "mcp__plugin_linear_linear__save_comment", tool_input: {issueId: $i, body: ($b | sub("\n+$"; ""))}}'
  } > "$plan"
  n="$(grep -c . "$plan")"
  bash "$FORGE_LEDGER" set "$rid" '.batch = {path: $p, at: $t, head: $h}' --arg p "$plan" --arg t "$(now_utc)" --arg h "$head"
  printf 'BATCH=%s\nENTRIES=%s\n' "$plan" "$n"
}

cmd="${1:?usage: forge launch|next|check|status|rework|retire|batch ...}"; shift
case "$cmd" in
  launch) cmd_launch "$@" ;;
  next) cmd_next ;;
  check) cmd_check ;;
  status) cmd_status ;;
  rework) cmd_rework "$@" ;;
  retire) cmd_retire "$@" ;;
  batch) cmd_batch "$@" ;;
  *) die "unknown command: $cmd" ;;
esac
